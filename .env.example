# 复制为 .env 并填入；.env 已在 .gitignore，不会提交。
# DeepSeek（OpenAI 兼容接口）。deepseek-flash = DeepSeek-V4.1-Flash（旧名 deepseek-v4-flash 仍可用）
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 理解层第三层（LLM 结构化抽取）：1 = 开（无 key 时自动退回规则路径，公开集零触发）
LLM_PARSE=1
# 所有成功的 LLM 回复写入这里；跑过一次后离线可逐字复现
LLM_CACHE_PATH=data/llm_cache.jsonl
